// NAGIH GRAPHY — data model
// Xem PLAN.md mục 4. Web là kênh giới thiệu thợ + thu thập lead, không phải hệ đặt chỗ.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- bảng giá

model Tier {
  id            String  @id @default(cuid())
  /// mã cũ trong bản artifact: e1, e2, e3, e4, intern
  slug          String  @unique
  name          String
  /// giá nửa ngày (một buổi) cho 1 người
  basePrice     Int     @default(0)
  /// giá cả ngày cho 1 người; 0 nghĩa là thợ báo giá
  fullDayPrice  Int     @default(0)
  note          String  @default("")
  /// ẩn khỏi bảng giá công khai (Take Care, Intern)
  hiddenInTable Boolean @default(false)
  order         Int     @default(0)

  groupPrices   GroupPrice[]
  photographers Photographer[]

  @@map("tiers")
}

/// Giá gói nhóm theo số người, thay cho mảng group[] trong bản cũ.
model GroupPrice {
  id     String @id @default(cuid())
  tierId String
  people Int
  price  Int

  tier Tier @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([tierId, people])
  @@map("group_prices")
}

// ---------------------------------------------------------------- thợ

model Photographer {
  id            String  @id @default(cuid())
  slug          String  @unique
  /// biệt danh hiện ngoài site
  name          String
  /// tên thật, chỉ dùng trong admin
  realName      String  @default("")
  tierId        String
  city          String
  style         String  @default("")
  bio           String  @default("")
  rating        Decimal @default(0) @db.Decimal(2, 1)
  sessions      Int     @default(0)
  /// chỉ điền khi thợ có giá khác hạng, 0 = theo hạng
  priceOverride Int     @default(0)
  driveUrl      String  @default("")
  /// Kênh liên hệ riêng của thợ. Không có sale, khách nhắn thẳng cho thợ.
  /// Trống thì trang khách rơi về liên hệ chung của studio trong site_settings.
  zalo          String  @default("")
  phone         String  @default("")
  facebook      String  @default("")
  instagram     String  @default("")
  published     Boolean @default(true)
  /// dữ liệu mẫu từ bản artifact, cần thay bằng thợ thật
  isSample      Boolean @default(false)
  order         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tier          Tier                  @relation(fields: [tierId], references: [id])
  photos        Photo[]
  features      PhotographerFeature[]
  tags          PhotographerTag[]
  availability  Availability[]
  scheduleNotes ScheduleNote[]
  leads         Lead[]
  user          AdminUser?
  schoolPhotos  SchoolPhoto[]
  submissions   PhotoSubmission[]
  stats         PhotographerStat[]

  @@index([published, order])
  @@index([city])
  @@map("photographers")
}

model Photo {
  id             String @id @default(cuid())
  photographerId String
  /// đường dẫn tương đối dưới /uploads, không phải URL tuyệt đối
  path           String
  width          Int    @default(0)
  height         Int    @default(0)
  blurHash       String @default("")
  alt            String @default("")
  order          Int    @default(0)

  createdAt DateTime @default(now())

  photographer Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@index([photographerId, order])
  @@map("photos")
}

// ---------------------------------------------------------------- dịch vụ đi kèm

enum FeatureStatus {
  IN // có sẵn trong gói
  EXTRA // có, tính thêm phí
  NO // không có
}

model Feature {
  id         String @id @default(cuid())
  /// mã cũ: bubble, light, outfit, assistant, raw
  key        String @unique
  label      String
  /// nhãn ngắn hiện trên card, rỗng = không hiện
  shortLabel String @default("")
  order      Int    @default(0)

  photographers PhotographerFeature[]

  @@map("features")
}

model PhotographerFeature {
  photographerId String
  featureId      String
  status         FeatureStatus @default(NO)

  photographer Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  feature      Feature      @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([photographerId, featureId])
  @@map("photographer_features")
}

// ---------------------------------------------------------------- tag

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  order Int    @default(0)

  photographers PhotographerTag[]

  @@map("tags")
}

model PhotographerTag {
  photographerId String
  tagId          String

  photographer Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([photographerId, tagId])
  @@map("photographer_tags")
}

// ---------------------------------------------------------------- phụ phí đi tỉnh

model TravelZone {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  /// phụ phí tham khảo cho 1 thợ
  minFee Int    @default(0)
  /// 0 = không có mức trần, hiển thị một con số
  maxFee Int    @default(0)
  note   String @default("")
  order  Int    @default(0)

  leads Lead[]

  @@map("travel_zones")
}

/// Các dòng chính sách hiển thị dưới bảng phụ phí.
model Policy {
  id    String @id @default(cuid())
  text  String
  order Int    @default(0)

  @@map("policies")
}

// ---------------------------------------------------------------- lịch

enum Half {
  MORNING
  AFTERNOON
}

enum AvailabilityStatus {
  FREE // rảnh, nhận được khách
  NAGIH // lịch NAGIH
  EXTERNAL // lịch chạy ngoài
  BUSY // bận, không nhận
}

/// Một thợ nhận tối đa 2 buổi mỗi ngày: sáng và chiều.
/// Chụp cả ngày chiếm cả hai ô. Lịch chỉ để hiển thị, khách không tự chiếm chỗ.
model Availability {
  id             String             @id @default(cuid())
  photographerId String
  date           DateTime           @db.Date
  half           Half
  status         AvailabilityStatus @default(FREE)

  updatedAt DateTime @updatedAt

  photographer Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@unique([photographerId, date, half])
  @@index([date, status])
  @@map("availability")
}

/// Ghi chú ngắn theo ngày của thợ: tên group, địa điểm, giờ.
model ScheduleNote {
  id             String   @id @default(cuid())
  photographerId String
  date           DateTime @db.Date
  /// ghi chú riêng từng buổi: tên group, địa điểm, giờ
  noteMorning    String   @default("")
  noteAfternoon  String   @default("")
  updatedAt      DateTime @updatedAt

  photographer Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@unique([photographerId, date])
  @@map("schedule_notes")
}

// ---------------------------------------------------------------- lead

enum ShootType {
  FULL_DAY
  HALF_DAY
}

enum LeadStatus {
  NEW // chưa ai liên hệ
  CONTACTED // sale đã nhắn
  QUOTED // đã báo giá
  DEPOSITED // đã cọc
  CONFIRMED // đã chốt lịch
  DONE // đã chụp
  LOST // mất khách
}

enum LeadChannel {
  ZALO
  INSTAGRAM
  FACEBOOK
  PHONE
  SMS
  FORM // điền form nhưng chưa bấm kênh nào
  MANUAL // sale tự nhập
}

model Lead {
  id             String  @id @default(cuid())
  /// mã ngắn để sale và khách cùng nhắc tới, VD: NG-2609-A7K3
  code           String  @unique
  photographerId String?

  customerName String
  phone        String
  zalo         String @default("")
  email        String @default("")

  shootDate    DateTime? @db.Date
  shootType    ShootType @default(FULL_DAY)
  people       Int       @default(1)
  travelZoneId String?
  placeDetail  String    @default("")
  concept      String    @default("")
  eveningAddon Boolean   @default(false)

  /// số đã hiển thị cho khách lúc đó, để sale đối chiếu. Không phải giá chốt.
  quotedBase   Int @default(0)
  quotedTravel Int @default(0)
  quotedTotal  Int @default(0)

  status       LeadStatus  @default(NEW)
  channel      LeadChannel @default(FORM)
  internalNote String      @default("")

  userAgent String @default("")
  referrer  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photographer Photographer? @relation(fields: [photographerId], references: [id], onDelete: SetNull)
  travelZone   TravelZone?   @relation(fields: [travelZoneId], references: [id], onDelete: SetNull)
  events       LeadEvent[]

  @@index([status, createdAt])
  @@index([shootDate])
  @@map("leads")
}

model LeadEvent {
  id         String      @id @default(cuid())
  leadId     String
  fromStatus LeadStatus?
  toStatus   LeadStatus
  actorId    String?
  note       String      @default("")
  createdAt  DateTime    @default(now())

  lead  Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_events")
}

// ---------------------------------------------------------------- chọn trường
// Xem docs/chon-truong.md. Ảnh Photo nộp vào photo_submissions, QC duyệt xong
// mới chép sang school_photos. Trang khách chỉ đọc school_photos.

enum SchoolStatus {
  LIVE // hiện ở lưới chính
  SOON // "Sắp có ảnh", tự chuyển LIVE khi đủ 4 ảnh duyệt
}

enum ShotKind {
  INDIVIDUAL // cá nhân
  GROUP // nhóm
}

enum SubmissionStatus {
  PENDING // chờ duyệt
  APPROVED // đã duyệt, đã có SchoolPhoto tương ứng
  REJECTED // bị trả lại kèm lý do, Photo sửa và nộp lại được
}

model School {
  id           String       @id @default(cuid())
  /// VD dai-hoc-thuong-mai, dùng cho /truong/<slug>
  slug         String       @unique
  name         String
  /// mã trường: TMU, NEU…
  short        String       @default("")
  city         String       @default("")
  /// đoạn giới thiệu ngắn do NAGIH viết
  intro        String       @default("")
  /// ảnh bìa, luôn là một ảnh đã duyệt của chính trường này
  coverPhotoId String?      @unique
  status       SchoolStatus @default(SOON)
  order        Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cover       SchoolPhoto?      @relation("SchoolCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  angles      SchoolAngle[]
  photos      SchoolPhoto[]     @relation("SchoolPhotos")
  submissions PhotoSubmission[]

  @@index([status, order])
  @@map("schools")
}

/// Danh mục góc chuẩn của một trường, QC quản. Góc đang có ảnh thì không xoá được, phải gộp.
model SchoolAngle {
  id       String @id @default(cuid())
  schoolId String
  name     String

  createdAt DateTime @default(now())

  school      School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  photos      SchoolPhoto[]
  submissions PhotoSubmission[]

  @@unique([schoolId, name])
  @@map("school_angles")
}

/// Ảnh trường đã duyệt, thứ duy nhất trang khách được đọc.
model SchoolPhoto {
  id             String    @id @default(cuid())
  schoolId       String
  angleId        String
  photographerId String
  year           Int
  kind           ShotKind  @default(INDIVIDUAL)
  /// ghi chú chụp của Photo: giờ nào đẹp, cần xin phép ai
  note           String    @default("")
  /// stem dưới /uploads, giống Photo.path: schools/<schoolId>/<id>
  path           String
  width          Int       @default(0)
  height         Int       @default(0)
  sortOrder      Int       @default(0)
  approvedAt     DateTime  @default(now())
  approvedById   String?
  /// chép từ bài nộp: ai tick cam kết khách đồng ý đăng ảnh, lúc nào
  consentAt      DateTime?
  consentById    String?

  createdAt DateTime @default(now())

  school       School       @relation("SchoolPhotos", fields: [schoolId], references: [id], onDelete: Cascade)
  angle        SchoolAngle  @relation(fields: [angleId], references: [id], onDelete: Restrict)
  photographer Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  approvedBy   AdminUser?   @relation("SchoolPhotoApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  consentBy    AdminUser?   @relation("SchoolPhotoConsentBy", fields: [consentById], references: [id], onDelete: SetNull)
  coverOf      School?      @relation("SchoolCover")

  @@index([schoolId, sortOrder])
  @@index([angleId])
  @@index([photographerId])
  @@map("school_photos")
}

/// Ảnh Photo nộp, chờ QC duyệt. Không bao giờ hiện ra trang khách.
model PhotoSubmission {
  id             String           @id @default(cuid())
  schoolId       String
  /// góc Photo chọn từ danh mục; trống thì xem angleText
  angleId        String?
  /// góc Photo tự gõ khi chưa có trong danh mục, QC sửa về tên chuẩn lúc duyệt
  angleText      String           @default("")
  photographerId String
  year           Int
  kind           ShotKind         @default(INDIVIDUAL)
  note           String           @default("")
  /// stem dưới /uploads: pending/<photographerId>/<id>, duyệt xong chuyển sang schools/
  path           String
  width          Int              @default(0)
  height         Int              @default(0)
  consent        Boolean          @default(false)
  consentAt      DateTime?
  consentById    String?
  status         SubmissionStatus @default(PENDING)
  rejectReason   String           @default("")
  reviewedById   String?
  reviewedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  angle        SchoolAngle? @relation(fields: [angleId], references: [id], onDelete: SetNull)
  photographer Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  consentBy    AdminUser?   @relation("SubmissionConsentBy", fields: [consentById], references: [id], onDelete: SetNull)
  reviewedBy   AdminUser?   @relation("SubmissionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([photographerId, status])
  @@index([schoolId])
  @@map("photo_submissions")
}

/// Đếm lượt khách mở ảnh và bấm Đặt từ ảnh trường, một hàng mỗi Photo mỗi ngày (giờ VN).
model PhotographerStat {
  photographerId String
  date           DateTime @db.Date
  views          Int      @default(0)
  bookClicks     Int      @default(0)

  photographer Photographer @relation(fields: [photographerId], references: [id], onDelete: Cascade)

  @@id([photographerId, date])
  @@map("photographer_stats")
}

// ---------------------------------------------------------------- quản trị

enum AdminRole {
  OWNER
  SALE
  VIEWER
  /// thợ: chỉ xem và sửa lịch của chính mình
  PHOTOGRAPHER
  /// QC duyệt ảnh trường: chỉ vào khu duyệt ảnh và danh mục góc của trường
  QC
}

model AdminUser {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String    @default("")
  passwordHash   String
  role           AdminRole @default(VIEWER)
  active         Boolean   @default(true)
  /// tài khoản của thợ thì trỏ tới thợ; id thợ luôn lấy từ đây, không lấy từ URL
  photographerId String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadEvents LeadEvent[]
  auditLogs  AuditLog[]

  approvedSchoolPhotos SchoolPhoto[]     @relation("SchoolPhotoApprovedBy")
  consentSchoolPhotos  SchoolPhoto[]     @relation("SchoolPhotoConsentBy")
  consentSubmissions   PhotoSubmission[] @relation("SubmissionConsentBy")
  reviewedSubmissions  PhotoSubmission[] @relation("SubmissionReviewedBy")
  photographer         Photographer?     @relation(fields: [photographerId], references: [id], onDelete: SetNull)

  @@map("admin_users")
}

/// Thông tin studio, liên hệ, nội dung landing. Một hàng một khoá.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  entity    String
  entityId  String
  action    String
  diff      Json?
  createdAt DateTime @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit .env — nó đã nằm trong .gitignore.

# ---------------------------------------------------------------- database
# Dùng chung instance Postgres sẵn có trên server, nhưng database và user riêng.
# Cách tạo: xem DEPLOY.md mục 1.
#
# Trên server (container nagih-web nói chuyện với container esm_postgres):
#   postgresql://nagih:matkhau@esm_postgres:5432/nagih?schema=public
# Chạy local với Postgres cài sẵn:
#   postgresql://nagih:matkhau@localhost:5432/nagih?schema=public
# Chạy local bằng npm run db:local (PGlite):
#   postgresql://postgres:postgres@127.0.0.1:55432/postgres
DATABASE_URL="postgresql://nagih:matkhau@localhost:5432/nagih?schema=public"

# ---------------------------------------------------------------- triển khai
# Chỉ dùng khi chạy docker compose trên server. Xem DEPLOY.md.
# Network của Traefik là `proxy`, đã điền cứng trong docker-compose.yml.
# Không thêm www vào đây: compose tự sinh router chuyển www về apex.
SITE_DOMAIN="nagihgraphy.com"

# Network mà container esm_postgres đang nằm trong đó. Lấy bằng:
#   docker inspect esm_postgres --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}'
DATABASE_NETWORK="esm_default"

# ---------------------------------------------------------------- auth admin
# Sinh chuỗi ngẫu nhiên:  openssl rand -base64 32
AUTH_SECRET=""
# Local: http://localhost:3000 — Server: https://nagihgraphy.com
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------- ảnh
# Trong container là /app/uploads (đã mount volume /srv/nagih/uploads).
# Chạy local thì để trống, mặc định là ./uploads.
UPLOAD_DIR=""
# Đường dẫn công khai của ảnh. Phải có tiền tố NEXT_PUBLIC_ để nhúng được
# vào bundle trình duyệt. Để trống thì mặc định /uploads.
NEXT_PUBLIC_UPLOAD_BASE="/uploads"

# ---------------------------------------------------------------- thông báo lead
# Telegram là kênh chính. Tạo bot qua @BotFather, lấy chat id qua @userinfobot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Email là tuỳ chọn. Để trống thì bỏ qua phần gửi mail.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NAGIH GRAPHY <no-reply@example.com>"

# ---------------------------------------------------------------- cron
# Token bảo vệ các route chạy định kỳ. Sinh giống AUTH_SECRET.
CRON_SECRET=""
